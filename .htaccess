<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # baladeirastudio.com (hospedagem Hostinger) redireciona para o site oficial em .com.br (GitHub Pages)
  RewriteCond %{HTTP_HOST} ^(www\.)?baladeirastudio\.com$ [NC]
  RewriteRule ^(.*)$ https://baladeirastudio.com.br/$1 [R=301,L]

  # Redireciona todas as requisições para o index.html, exceto arquivos reais
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
